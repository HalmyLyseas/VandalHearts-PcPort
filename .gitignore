# splat extraction / build output
/asm/
/assets/
/build/

# staging/communication layer — not part of the project's committed content
/exchange/
/context.txt

# Local toolchain + SDK source + game data, moved under external/ from sibling dirs (2026-07-24).
# MUST NEVER be committed — proprietary and/or large: the Sony PsyQ SDK source (external/psy-q),
# the game disc images + SLUS_004.47 (external/game), and the old-gcc / maspsx / binutils toolchain
# (external/old-gcc, external/maspsx, external/toolchain). external/references lists the upstream
# URLs to re-obtain any of it. This whole tree is local-build-use-only.
/external/

# proprietary Sony PsyQ SDK headers (from a v3.3 SDK mirror, unclear redistribution rights) —
# local build use only, must never be committed/pushed. See exchange/00-progress-checkpoint.md.
/include/PsyQ/

# maspsx vendored via local symlink, not a real part of this repo's tree
/tools/maspsx

# the copyrighted base game executable — from the user's own legally-owned copy, never commit
/SLUS_004.47

# splat-generated build inputs (linker scripts, undefined-symbol lists) from make extract
/SLUS_004.47.ld
/undefined_syms_auto.txt
/undefined_funcs_auto.txt
/symbols.csv

# symlink so "#include \"assets/X.inc\"" resolves via the existing -Iinclude search path
# (assets/ itself is already covered by the /assets/ rule above)
/include/assets

# Phase C PC-port build output (source under platform/pc/ is real, tracked content).
# build*/ also catches build_asan/ (sanitizer build) and any future variant build dirs.
/platform/pc/build*/

# PC-port runtime output: save files + unit-test scratch audio. `saves/` (unanchored) catches the
# folder wherever the game creates it -- next to the exe (platform/pc/saves/) or the repo root when
# run from there (cwd-relative). test_vag1.wav is written by the libsnd unit test.
saves/
/platform/pc/test_vag1.wav

# AppImage packaging output (dist/ = AppDir + the .AppImage) and the icon PNG rasterized from
# the committed vandalhearts.svg by build-appimage.sh. The SVG, .desktop, and script ARE tracked.
/platform/pc/dist/
/platform/pc/packaging/appimage/vandalhearts.png

# Sanitizer run logs (ASan/UBSan) + the archived per-run copies made by run_asan.sh/run_ubsan.sh.
# Diagnostics only -- and their stack traces embed the BUILD MACHINE'S ABSOLUTE PATHS
# (/home/<user>/...), i.e. the developer's login name, so they must never be committed.
# The findings themselves are written up in exchange/58 + exchange/60 instead.
/platform/pc/asan.log.*
/platform/pc/ubsan.log.*
/platform/pc/asan_runs/
/platform/pc/ubsan_runs/

# env-gated PC-port debug dumps (per-frame CSVs / logs) written to cwd or platform/pc/;
# these are diagnostics, never committed (VH_XA_CSV, VH_XA_LOG, SPRITE_LOG, etc.)
vh_*.csv
vh_*.txt
vh_*.log
# ...and VH_SPU_DUMPVAG=1 writes decoded VAB samples as vh_vag_<vab>_<n>.wav. These are
# EXTRACTED GAME AUDIO, not just diagnostics -- same category as the PsyQ headers and the
# base executable, and must never enter the repo. (Only a single test_vag1.wav was covered
# before, so 86 dumps were sitting untracked-but-addable.)
vh_*.wav

# ---- game/BIOS-derived data files: GENERATED at build time, never committed ----
# These reconstruct copyrighted content (Konami UI text, PS1 BIOS kanji glyphs, extracted game
# data) from the user's OWN legally-owned copy: the byte-exact build/SLUS_004.47 and the PsyQ
# KROMDAT.BIN -- both already required by the build. Committing them would distribute copyrighted
# data; regenerating them keeps the source tree free of it (same model as build/generated_data.c).
# Regenerated by platform/pc/tools/gen_*.py via the Makefile / CMake build. See exchange/60.
/platform/pc/src/pc_kanji_font.c
/platform/pc/src/pc_spell_descriptions.c
/platform/pc/src/pc_item_descriptions.c
/platform/pc/src/pc_evt_entities.c
/platform/pc/src/pc_string_table.c

__pycache__/

# Working sets and built packs are generated from YOUR OWN disc: they contain retail game text and
# must NEVER be committed (this repo ships no game text). These rules catch them by STRUCTURE, so a
# working set or pack created anywhere under this tools directory is ignored regardless of the folder
# name you choose. The recommended place to work is platform/pc/tools/langpack/work/ (below).
/work/
/work*/
/out/
/out*/
/packs/
/langpacks/
# A working set is a folder holding strings/ + translate/; a built pack holds langpacks/<name>/.
# Match those wherever they land under this directory.
**/strings/
**/translate/
**/langpacks/

# The HD pack (F2 localized backgrounds): translators copy it in to source background hashes and to
# validate. It is disc-derived upscaled art -- game-derived, must NEVER be committed. Catch it
# wherever it lands under this directory.
/hdpacks/
**/hdpacks/

# Glyph-art sheets emitted by `lang_template --out` / `gen_packart` (font8x9/16x15 + proofs).
# Generated working artifacts, regenerable from the bundled Unifont -- keep them out by structure,
# whatever the output folder is named.
**/font8x9.png
**/font8x9.txt
**/font16x15.png
**/font16x15.txt
**/proof_8x9.png
**/proof_16x15.png
